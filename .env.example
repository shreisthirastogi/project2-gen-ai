# Required
OPENAI_API_KEY=sk-...

# Optional: enables Cohere reranking
COHERE_API_KEY=...

# Qdrant vector DB (use Qdrant Cloud free tier)
QDRANT_HOST=your-cluster.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=...

# Optional: Langfuse tracing
LANGFUSE_PUBLIC_KEY=...
LANGFUSE_SECRET_KEY=...
LANGFUSE_HOST=https://cloud.langfuse.com
